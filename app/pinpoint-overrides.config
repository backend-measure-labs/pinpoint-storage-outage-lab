# 운영 release 프로필이 공개 기본값에서 바꾼 값. 컬렉터 주소만 이 랩의 서비스 이름으로 바꿨다.
profiler.activemq.client.enable=false
profiler.apache.httpclient3.cookie=true
profiler.apache.httpclient4.cookie=true
profiler.apache.httpclient5.cookie=true
profiler.arcus=false
profiler.cassandra=false
profiler.hbase.client.enable=false
profiler.http.record.request.headers=Authorization
profiler.interceptorregistry.size=65536
profiler.jdbc.cubrid=false
profiler.jdbc.druid=false
profiler.jdbc.informix=false
profiler.jdbc.jtds=false
profiler.jdbc.mariadb.commit=true
profiler.jdbc.mariadb.rollback=true
profiler.jdbc.mariadb.setautocommit=true
profiler.jdbc.mssql=false
profiler.jdbc.mysql.commit=true
profiler.jdbc.mysql.rollback=true
profiler.jdbc.mysql.setautocommit=true
profiler.jdbc.oracle=false
profiler.jdbc.postgresql=false
profiler.json.jackson=true
profiler.jvm.stat.collect.detailed.metrics=true
profiler.kafka.consumer.enable=false
profiler.kafka.producer.enable=false
profiler.memcached=false
profiler.paho.mqtt.client.enable=false
profiler.rabbitmq.client.enable=false
profiler.sampling.percent.sampling-rate=10
profiler.sampling.type=PERCENT
profiler.springkafka.consumer.enable=false
profiler.thrift.client=false
profiler.thrift.enable=false
profiler.transport.grpc.collector.ip=pinpoint-collector
